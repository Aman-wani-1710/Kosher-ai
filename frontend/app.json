{
  "expo": {
    "name": "Kosher AI",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.koshuraiassistant.vbehw4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FDFBF7"
      },
      "package": "com.emergent.koshuraiassistant.vbehw4"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Record your Kashmiri speech to chat with the voice assistant",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photoPermission": "Choose a photo to set as the app logo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}